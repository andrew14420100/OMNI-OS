# OMNI OS — anteprima del desktop OMNI (sperimentale, solo macchina virtuale).
# Parte dall'immagine OMNI di prova costruita dalla base B3 verificata e aggiunge la
# sessione "OMNI OS": OMNI Shell è l'unica interfaccia (barra, Start, pannelli, notifiche)
# sopra KWin e i servizi di Plasma, che restano l'infrastruttura. La sessione Plasma
# originale resta disponibile all'accesso come modalità sicura.
#   podman build --build-arg OMNI_IMAGE=localhost/omni-os:m1-ci image/personale/
ARG OMNI_IMAGE
# hadolint ignore=DL3006
FROM ${OMNI_IMAGE}

LABEL org.opencontainers.image.title="OMNI OS (anteprima del desktop OMNI)" \
      org.opencontainers.image.description="Anteprima sperimentale con OMNI Shell come interfaccia del desktop. Solo macchina virtuale."

# omni-shell/ è prodotto da tests/vm/build_shell_bundle.sh (Qt di Fedora 45)
COPY omni-shell/ /usr/lib/omni-shell/
COPY files/ /

RUN chmod 0755 /usr/bin/omni-shell /usr/lib/omni-shell/bin/omni-shell-prototipo /usr/libexec/omni-os/* && \
    test -x /usr/bin/startplasma-wayland && \
    mkdir -p /usr/share/fonts/omni-inter && \
    find /usr/lib/omni-shell/fonts -type f \( -name '*.otf' -o -name '*.ttf' -o -name '*.ttc' \) -exec cp {} /usr/share/fonts/omni-inter/ \; && \
    test -n "$(ls -A /usr/share/fonts/omni-inter)" && \
    rm -rf /usr/lib/omni-shell/fonts && \
    fc-cache -f /usr/share/fonts/omni-inter >/dev/null && \
    bootc container lint
